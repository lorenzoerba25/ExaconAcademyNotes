    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var">
        <mapperTableEntries name="vEmpName" expression="StringHandling.UPCASE(&#xD;&#xA;    emp1.fname + &quot; &quot; + &#xD;&#xA;    (StringHandling.TRIM(emp1.minit.toString()).equals(&quot;&quot;) ? &quot;&quot; : emp1.minit.toString() + &quot;.&quot;) &#xD;&#xA;    + emp1.lname&#xD;&#xA;) " type="id_String"/>
        <mapperTableEntries name="vJobDesc" expression="job1.job_desc.split(&quot;&quot;).length >0 ? job1.job_desc.split(&quot; &quot;)[0] : job1.job_desc " type="id_String"/>
        <mapperTableEntries name="vMinLvl" expression="BigDecimal.valueOf( job1.min_lvl)" type="id_BigDecimal"/>
        <mapperTableEntries name="vMaxLvl" expression="BigDecimal.valueOf( job1.max_lvl)" type="id_BigDecimal"/>
        <mapperTableEntries name="vAvgLvl" expression="Var.vMaxLvl.add(Var.vMinLvl).divide(BigDecimal.valueOf(2)) " type="id_BigDecimal"/>
        <mapperTableEntries name="vEmpIdNoMinus" expression="emp1.emp_id.replace(&quot;-&quot;,&quot;&quot;)" type="id_String"/>
        <mapperTableEntries name="vHireDate" expression="TalendDate.formatDate(&quot;dd/MM/yyyy&quot;,emp1.hire_date) " type="id_String"/>
      </varTables>
      <outputTables sizeState="INTERMEDIATE" name="out">
        <mapperTableEntries name="emp_id" expression="emp1.emp_id " type="id_String" nullable="true"/>
        <mapperTableEntries name="emp_name" expression=" Var.vEmpName " type="id_String" nullable="true"/>
        <mapperTableEntries name="job_id" expression="emp1.job_id " type="id_Integer" nullable="true"/>
        <mapperTableEntries name="job_desc" expression="Var.vJobDesc " type="id_String" nullable="true"/>
        <mapperTableEntries name="min_lvl" expression="Var.vMinLvl " type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="max_lvl" expression="Var.vMaxLvl " type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="avg_lvl" expression="Var.vAvgLvl " type="id_BigDecimal" nullable="true"/>
        <mapperTableEntries name="emp_id_no_minus" expression="Var.vEmpIdNoMinus " type="id_String" nullable="true"/>
        <mapperTableEntries name="hire_date" expression="Var.vHireDate " type="id_String" nullable="true"/>
      </outputTables>
